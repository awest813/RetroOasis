{
  "id": "./",
  "name": "RetroOasis",
  "short_name": "RetroOasis",
  "description": "Browse and play your retro ROM library in the browser.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#071018",
  "theme_color": "#071018",
  "categories": ["games", "entertainment"],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "./#/upload",
      "accept": {
        "application/octet-stream": [
          ".nes", ".sfc", ".smc", ".gb", ".gbc", ".gba", ".nds", ".z64", ".n64",
          ".iso", ".cso", ".pbp", ".cue", ".bin", ".img", ".chd", ".ccd", ".m3u",
          ".md", ".gen", ".smd", ".sms", ".gg", ".32x", ".zip", ".7z", ".rar",
          ".cia", ".3ds", ".cci", ".pce", ".adf", ".d64", ".exe"
        ]
      },
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }],
      "launch_type": "single-client"
    }
  ],
  "shortcuts": [
    {
      "name": "Library",
      "short_name": "Library",
      "description": "Browse your ROM shelf",
      "url": "./#/library/@all",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Add ROM",
      "short_name": "Add ROM",
      "description": "Save a ROM on this device",
      "url": "./#/upload",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "description": "Look, sound, emulator, and data",
      "url": "./#/settings",
      "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }]
    }
  ]
}
