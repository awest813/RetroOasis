{
  "name": "retrooasis",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Static RetroOasis frontend for EmulatorJS ROM library browsing and play",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "manifest": "node scripts/generate-roms-manifest.mjs",
    "scan": "node scripts/scan-roms.mjs",
    "test:archives": "node scripts/test-archives.mjs",
    "test:upload-flow": "node scripts/test-upload-flow.mjs",
    "test:router": "node scripts/test-router.mjs",
    "test:overrides": "node scripts/test-overrides.mjs",
    "test:saves": "node scripts/test-saves.mjs",
    "test:gamepad": "node scripts/test-gamepad.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
